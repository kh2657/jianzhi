{
  "name": "studybench",
  "productName": "数学学习工作台",
  "version": "0.1.0",
  "description": "本地优先的数学学习工作台：PDF 阅读与可回溯摘录、手写批注、Markdown/KaTeX 笔记与 Wiki、文献库与学习日历",
  "private": true,
  "author": "kh",
  "engines": {
    "node": ">=23.6"
  },
  "main": "out/main/index.js",
  "scripts": {
    "assets:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "fixtures": "node scripts/gen-fixtures.ts",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:plan": "node scripts/affected-tests.mjs",
    "test:fast": "node scripts/affected-tests.mjs --run",
    "e2e:fast": "node scripts/affected-tests.mjs --run --e2e",
    "check": "npm run typecheck && npm run test",
    "gate": "npm run check && npm run e2e",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs --quiet",
    "dev": "npm run assets:pdfjs && electron-vite dev",
    "dev:isolated": "node scripts/dev-isolated.mjs",
    "build": "npm run assets:pdfjs && electron-vite build",
    "dist": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "install:mac": "node scripts/install-mac.mjs",
    "install:mac:full": "node scripts/install-mac.mjs --full",
    "update:win": "npm run typecheck && npm run build && electron-builder --win --dir",
    "selftest": "npm run build && electron out/main/index.js --self-test",
    "e2e": "npm run build && playwright test",
    "e2e:serial": "playwright test --workers=1",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "shots": "node scripts/shoot-screens.mjs",
    "gen:daily-sample": "node scripts/gen-daily-sample.mjs",
    "migrate": "node scripts/migrate-sqlite-to-folders.ts"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "^5.11.2",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "13.0.3",
    "electron": "^40.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
